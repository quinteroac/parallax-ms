# Parallax gateway — copy to ".env" and adjust. Placeholders only (no real secrets).
#
# --- Phase 1 (optional; defaults match README) ---
# PORT=3000
#
# Path to models.config.json. Defaults to models.config.json at the project root.
# MODELS_CONFIG_PATH=/absolute/path/to/models.config.json
#
# --- Later phases (placeholders; uncomment when wiring integration) ---
# WORKER_BASE_URL=https://your-worker-host.example
# GATEWAY_PUBLIC_URL=https://your-gateway.example
# INTERNAL_CALLBACK_SECRET=your-shared-secret-placeholder
